#!/usr/bin/bash

set -euf

set -a
BQ_BUMPED_TAG_VERSION=$(git cliff --bumped-version)
# Drop 'v' from beginning of semver.
# Ex: v0.1.0 -> 0.1.0
BQ_BUMPED_GALAXY_VERSION=${BQ_BUMPED_TAG_VERSION:1}
BQ_RELEASE_COMMIT_MESSAGE="chore(release): prepare for ${BQ_BUMPED_TAG_VERSION}"
BQ_RELEASE_TAG_MESSAGE="Release ${BQ_BUMPED_TAG_VERSION}"
set +a
