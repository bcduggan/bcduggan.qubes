#!/usr/bin/sh

set -euf

. /dev/stdin <<EOF
$(yq --output-format shell galaxy.yml)
EOF

set -a
BQ_NAMESPACE="${namespace}"
BQ_NAME="${name}"
BQ_VERSION="${version}"
BQ_COLLECTION="${BQ_NAMESPACE}-${BQ_NAME}"
BQ_PACKAGE="${BQ_COLLECTION}-${BQ_VERSION}"
BQ_ARCHIVE="${BQ_PACKAGE}.tar.gz"
BQ_SIGNATURE="${BQ_PACKAGE}.sig"
BQ_MANIFEST="${BQ_PACKAGE}-MANIFEST.json"
set +a
